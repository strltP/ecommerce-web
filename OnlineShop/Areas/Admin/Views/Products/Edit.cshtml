@model OnlineShop.Models.Db.Product
@{
    ViewData["Title"] = "Cập nhật sản phẩm";
    var galleries = ViewData["gallery"] as List<OnlineShop.Models.Db.ProductGallery>;
}

<h2 class="mb-4">🛠️ Cập nhật sản phẩm</h2>

<form asp-action="Edit" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageName" />

    <div class="row">
        <div class="col-md-8">

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Tên sản phẩm</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Mô tả ngắn gọn</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FullDesc" class="form-label">Mô tả đầy đủ</label>
                <textarea asp-for="FullDesc" class="form-control" rows="5"></textarea>
                <span asp-validation-for="FullDesc" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label">Giá bán</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Discount" class="form-label">Giảm giá</label>
                    <input asp-for="Discount" class="form-control" />
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Qty" class="form-label">Số lượng sản phẩm</label>
                <input asp-for="Qty" class="form-control" />
                <span asp-validation-for="Qty" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tags" class="form-label"></label>
                <input asp-for="Tags" class="form-control" />
                <span asp-validation-for="Tags" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VideoUrl" class="form-label">Đường dẫn video</label>
                <input asp-for="VideoUrl" class="form-control" />
                <span asp-validation-for="VideoUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Danh mục</label>
                <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

        </div>

        <div class="col-md-4">

            <div class="mb-3">
                <label class="form-label">Ảnh đại diện</label>
                <input type="file" name="MainImage" class="form-control" />
                <div class="border p-1" style="width: 200px; height: 200px; overflow: hidden;">
                    <img src="/images/banners/@Model.ImageName"
                         class="img-fluid"
                         style="width: 100%; height: 100%; object-fit: contain;" />
                </div>

            </div>

            <div class="mb-3">
                <label class="form-label">Ảnh gallery</label>
                <input type="file" name="GalleryImages" multiple class="form-control" />
            </div>

            @if (galleries != null && galleries.Any())
            {
                <div class="row g-2">
                    @foreach (var item in galleries)
                    {
                        <div class="col-6">
                            <img src="/images/banners/@item.ImageName" class="img-thumbnail w-100 mb-1" />
                            <a href="/admin/products/DeleteGallery?id=@item.Id" class="btn btn-sm btn-danger w-100">
                                <i class="fa fa-trash"></i> Xoá
                            </a>
                        </div>
                    }
                </div>
            }

        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="fa fa-save"></i> Lưu thay đổi
        </button>
        <a asp-action="Index" class="btn btn-secondary ms-2">⬅ Quay lại</a>
    </div>
</form>
