@model IEnumerable<OnlineShop.Models.Db.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h2 class="mb-4">📦 Danh sách sản phẩm</h2>

<p>
    <a asp-action="Create" class="btn btn-success">
        <i class="fa fa-plus"></i> Thêm sản phẩm
    </a>
</p>

<table class="table table-bordered table-striped align-middle table-hover">
    <thead class="table-dark text-center">
        <tr>
            <th>Ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Giảm giá</th>
            <th>Số lượng</th>
            <th>Tags</th>
            <th style="width: 150px;">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-center">
                    <img src="/images/banners/@item.ImageName" class="img-thumbnail" style="max-width: 80px;" />
                </td>
                <td>@item.Title</td>
                <td>@($"{item.Price:N0} VND")</td>
                <td>@($"{item.Discount:N0} VND")</td>
                <td class="text-center">@item.Qty</td>
                <td>@item.Tags</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1">
                        <i class="fa fa-edit"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1">
                        <i class="fa fa-eye"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Bạn có chắc chắn muốn xoá sản phẩm này?');">
                        <i class="fa fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
