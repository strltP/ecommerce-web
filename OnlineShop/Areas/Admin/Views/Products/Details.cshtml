@model OnlineShop.Models.Db.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<h2 class="mb-4">📄 Thông tin chi tiết</h2>

<div class="row">
    <div class="col-md-4 text-center">
        <img src="/images/banners/@Model.ImageName" class="img-thumbnail mb-3" style="max-height: 300px; object-fit: contain;" />

        @if (!string.IsNullOrEmpty(Model.VideoUrl))
        {
            <div class="ratio ratio-16x9 mb-2">
                <iframe src="@Model.VideoUrl" allowfullscreen></iframe>
            </div>
        }
    </div>

    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-4">Tên sản phẩm</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Mô tả ngắn</dt>
            <dd class="col-sm-8">@Model.Description</dd>

            <dt class="col-sm-4">Mô tả đầy đủ</dt>
            <dd class="col-sm-8">@Model.FullDesc</dd>

            <dt class="col-sm-4">Giá</dt>
            <dd class="col-sm-8">@($"{Model.Price:N0} VND")</dd>

            <dt class="col-sm-4">Giảm giá</dt>
            <dd class="col-sm-8">@($"{Model.Discount:N0} VND")</dd>

            <dt class="col-sm-4">Số lượng</dt>
            <dd class="col-sm-8">@Model.Qty</dd>

            <dt class="col-sm-4">Tags</dt>
            <dd class="col-sm-8">@Model.Tags</dd>

            <dt class="col-sm-4">Video URL</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <a href="@Model.VideoUrl" target="_blank">@Model.VideoUrl</a>
                }
                else
                {
                    <em>Không có</em>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="fa fa-edit"></i> Chỉnh sửa
    </a>
    <a asp-action="Index" class="btn btn-secondary ms-2">⬅ Quay lại danh sách</a>
</div>
