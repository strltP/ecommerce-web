@model OnlineShop.Models.Db.Banner

@{
    ViewData["Title"] = "Chi tiết Banner";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="fa fa-info-circle me-2"></i>Chi tiết banner
                    </h4>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Tiêu đề</dt>
                        <dd class="col-sm-8">@Model.Title</dd>

                        <dt class="col-sm-4">Phụ đề</dt>
                        <dd class="col-sm-8">@Model.SubTitle</dd>

                        <dt class="col-sm-4">Hình ảnh</dt>
                        <dd class="col-sm-8">
                            <img src="/images/banners/@Model.ImageName" class="img-thumbnail shadow-sm" style="max-width: 200px;" alt="Banner Image" />
                            <div class="text-muted small mt-1">@Model.ImageName</div>
                        </dd>

                        <dt class="col-sm-4">Thứ tự ưu tiên</dt>
                        <dd class="col-sm-8">@Model.Priority</dd>

                        <dt class="col-sm-4">Đường dẫn</dt>
                        <dd class="col-sm-8">
                            <a href="@Model.Link" target="_blank">@Model.Link</a>
                        </dd>

                        <dt class="col-sm-4">Vị trí</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.Position</span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                        <i class="fa fa-edit"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
