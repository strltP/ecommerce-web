@model IEnumerable<OnlineShop.Models.Db.Banner>

@{
    ViewData["Title"] = "Danh sách Banner";
}

<h2 class="mb-4">🖼️ Danh sách Banner</h2>

<div class="mb-3 text-end">
    <a asp-action="Create" class="btn btn-success">
        <i class="fa fa-plus"></i> Thêm Banner mới
    </a>
</div>

<table class="table table-bordered table-hover table-striped align-middle">
    <thead class="table-dark text-center">
        <tr>
            <th>Tiêu đề</th>
            <th>Phụ đề</th>
            <th>Hình ảnh</th>
            <th>Ưu tiên</th>
            <th>Liên kết</th>
            <th>Vị trí</th>
            <th style="width: 160px;">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.SubTitle</td>
                <td class="text-center">
                    <img src="/images/banners/@item.ImageName" class="img-thumbnail shadow-sm" style="max-width: 100px;" alt="@item.Title" />
                </td>
                <td class="text-center">@item.Priority</td>
                <td>@item.Link</td>
                <td class="text-center">
                    <span class="badge bg-secondary">@item.Position</span>
                </td>
                <td class="text-center">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1" title="Xem chi tiết">
                        <i class="fa fa-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1" title="Chỉnh sửa">
                        <i class="fa fa-edit"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Xoá"
                       onclick="return confirm('Bạn có chắc chắn muốn xoá banner này?');">
                        <i class="fa fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
