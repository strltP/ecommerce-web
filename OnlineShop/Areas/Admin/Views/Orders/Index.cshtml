@model IEnumerable<OnlineShop.Models.Db.Order>

@{
    ViewData["Title"] = "Đơn hàng";
}

<h2 class="mb-4">📦 Danh sách đơn hàng</h2>

<table class="table table-bordered table-hover table-striped align-middle">
    <thead class="table-dark text-center">
        <tr>
            <th>Khách hàng</th>
            <th>Tổng tiền</th>
            <th>Ngày đặt</th>
            <th>Trạng thái</th>
            <th style="width: 160px;">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var fullName = $"{item.FirstName} {item.LastName}";
            var statusClass = item.Status?.ToLower() switch
            {
                "pending" => "badge bg-warning text-dark",
                "completed" => "badge bg-success",
                "cancelled" => "badge bg-danger",
                _ => "badge bg-secondary"
            };

            <tr>
                <td>@fullName</td>
                <td>@($"{item.Total:N0} VND")</td>
                <td>@item.CreateDate?.ToString("dd/MM/yyyy HH:mm")</td>
                <td><span class="@statusClass">@item.Status</span></td>
                <td class="text-center">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1">
                        <i class="fa fa-eye"></i>
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1">
                        <i class="fa fa-edit"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Bạn có chắc muốn xoá đơn hàng này?');">
                        <i class="fa fa-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
