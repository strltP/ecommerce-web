@model OnlineShop.Models.Db.Order

@{
    ViewData["Title"] = "Cập nhật đơn hàng";
    var orderDetails = ViewData["OrderDetails"] as List<OnlineShop.Models.Db.OrderDetail>;
}

<h2 class="mb-4">📝 Cập nhật đơn hàng</h2>

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="UserId" class="form-label">ID Khách hàng</label>
                <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId" disabled></select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">Họ</label>
                <input asp-for="FirstName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">Tên</label>
                <input asp-for="LastName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                <input asp-for="Phone" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">Trạng thái đơn hàng</label>
                <input asp-for="Status" class="form-control" disabled>
                   
                </input>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CreateDate" class="form-label">Ngày tạo đơn hàng</label>
                <input asp-for="CreateDate" class="form-control" type="datetime-local"
                       value="@Model.CreateDate?.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
        </div>

        <div class="col-md-6">

            <div class="mb-3">
                <label asp-for="CompanyName" class="form-label">Tên công ty</label>
                <input asp-for="CompanyName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Country" class="form-label">Quốc gia</label>
                <input asp-for="Country" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">Địa chỉ nhận hàng</label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="City" class="form-label">Tỉnh/Thành phố</label>
                <input asp-for="City" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Comment" class="form-label">Ghi chú</label>
                <textarea asp-for="Comment" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="CouponCode" class="form-label">Mã giảm giá</label>
                <input asp-for="CouponCode" class="form-control" disabled/>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="CouponDiscount" class="form-label">Số tiền giảm giá</label>
                    <input asp-for="CouponDiscount" class="form-control" disabled />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Shipping" class="form-label">Phí vận chuyển</label>
                    <input asp-for="Shipping" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="SubTotal" class="form-label">Tạm tính</label>
                    <input asp-for="SubTotal" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Total" class="form-label">Tổng tiền</label>
                <input asp-for="Total" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="TransId" class="form-label">Mã giao dịch</label>
                <input asp-for="TransId" class="form-control" disabled />
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="fa fa-save"></i> Lưu thay đổi
        </button>
        <a asp-action="Index" class="btn btn-secondary ms-2">⬅ Quay lại</a>
    </div>
</form>

@if (orderDetails != null && orderDetails.Any())
{
    <hr class="my-4" />
    <h5>🧾 Chi tiết đơn hàng</h5>

    <table class="table table-bordered table-striped">
        <thead class="table-light text-center">
            <tr>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in orderDetails)
            {
                var total = item.Count * item.ProductPrice;
                <tr>
                    <td>@item.ProductTitle</td>
                    <td class="text-end">@($"{item.ProductPrice:N0} VND")</td>
                    <td class="text-center">@item.Count</td>
                    <td class="text-end fw-bold">@($"{total:N0} VND")</td>
                </tr>
            }
        </tbody>
    </table>
}
