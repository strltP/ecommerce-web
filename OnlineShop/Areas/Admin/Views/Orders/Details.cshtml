@model OnlineShop.Models.Db.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2 class="mb-4">📄 Chi tiết đơn hàng</h2>

<dl class="row">
    <dt class="col-sm-3">Khách hàng</dt>
    <dd class="col-sm-9">@($"{Model.FirstName} {Model.LastName}")</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Số điện thoại</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Công ty</dt>
    <dd class="col-sm-9">@Model.CompanyName</dd>

    <dt class="col-sm-3">Địa chỉ nhận hàng</dt>
    <dd class="col-sm-9">@($"{Model.Address}, {Model.City}, {Model.Country}")</dd>

    <dt class="col-sm-3">Ghi chú</dt>
    <dd class="col-sm-9">@Model.Comment</dd>

    <dt class="col-sm-3">Mã giảm giá</dt>
    <dd class="col-sm-9">@Model.CouponCode</dd>

    <dt class="col-sm-3">Số tiền giảm giá</dt>
    <dd class="col-sm-9">@($"{Model.CouponDiscount:N0} VND")</dd>

    <dt class="col-sm-3">Phí vận chuyển</dt>
    <dd class="col-sm-9">@($"{Model.Shipping:N0} VND")</dd>

    <dt class="col-sm-3">Tạm tính</dt>
    <dd class="col-sm-9">@($"{Model.SubTotal:N0} VND")</dd>

    <dt class="col-sm-3 fw-bold">Tổng thanh toán</dt>
    <dd class="col-sm-9 fw-bold text-danger">@($"{Model.Total:N0} VND")</dd>

    <dt class="col-sm-3">Ngày đặt hàng</dt>
    <dd class="col-sm-9">@Model.CreateDate?.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Mã giao dịch</dt>
    <dd class="col-sm-9">@Model.TransId</dd>

    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        <i class="fa fa-edit"></i> Chỉnh sửa
    </a>
    <a asp-action="Index" class="btn btn-secondary ms-2">⬅ Quay lại</a>
</div>
