@model OnlineShop.Models.Db.Menu

@{
    ViewData["Title"] = "Chi tiết Menu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="fa fa-info-circle me-2"></i>Chi tiết menu
                    </h4>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Tiêu đề</dt>
                        <dd class="col-sm-8">@Model.MenuTitle</dd>

                        <dt class="col-sm-4">Liên kết</dt>
                        <dd class="col-sm-8">@Model.Link</dd>

                        <dt class="col-sm-4">Vị trí</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary text-uppercase">@Model.Type</span>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                        <i class="fa fa-edit"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
