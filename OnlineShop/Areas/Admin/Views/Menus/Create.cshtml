@model OnlineShop.Models.Db.Menu

@{
    ViewData["Title"] = "Thêm menu mới";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fa fa-plus-circle me-2"></i>Thêm menu mới</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="MenuTitle" class="form-label"></label>
                            <input asp-for="MenuTitle" class="form-control" placeholder="Nhập tiêu đề menu" />
                            <span asp-validation-for="MenuTitle" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Link" class="form-label"></label>
                            <input asp-for="Link" class="form-control" placeholder="Ví dụ: /san-pham" />
                            <span asp-validation-for="Link" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Type" class="form-label"></label>
                            <select asp-for="Type" class="form-select">
                                <option value="Top">Top</option>
                                <option value="Bottom">Bottom</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">
                                <i class="fa fa-save me-1"></i> Lưu menu
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Index" class="btn btn-link">
                        <i class="fa fa-arrow-left"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
