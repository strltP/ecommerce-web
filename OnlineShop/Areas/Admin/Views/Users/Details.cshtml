@model OnlineShop.Models.Db.User

@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="fa fa-user me-2"></i>Thông tin người dùng
                    </h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">📧 Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">👤 Họ tên</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">🔐 Mật khẩu</dt>
                        <dd class="col-sm-8 text-muted">••••••••</dd>

                        <dt class="col-sm-4">🎖️ Vai trò</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsAdmin)
                            {
                                <span class="badge bg-danger"><i class="fa fa-shield-alt me-1"></i>Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="fa fa-user me-1"></i>Khách</span>
                            }
                        </dd>

                        <dt class="col-sm-4">🕒 Ngày đăng ký</dt>
                        <dd class="col-sm-8">@Model.RegisterDate</dd>

                        <dt class="col-sm-4">🔁 Recovery Code</dt>
                        <dd class="col-sm-8">@Model.RecoveryCode</dd>
                    </dl>
                </div>
                <div class="card-footer text-center">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary me-2">
                        <i class="fa fa-edit"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
